{
  "name": "@zhdzh-good/multi-role-groupchat",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Multi-role group chat panel with an owner profile, @ routing, handoffs, pins, rewrites, token budgets, and Markdown export.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "author": "zhdzh-good",
  "license": "MIT",
  "homepage": "https://github.com/zhdzh-good/multi-role-groupchat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhdzh-good/multi-role-groupchat.git",
    "directory": "multi-role-groupchat"
  },
  "bugs": {
    "url": "https://github.com/zhdzh-good/multi-role-groupchat/issues"
  }
}
